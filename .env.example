# Environment Variables — Personality Platform
# Copy this file to .env.local and fill in your values

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Local PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/personality_platform"
# Or Neon/Supabase:
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require"

# ─────────────────────────────────────────────
# NEXTAUTH / AUTH.JS
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-here-generate-a-strong-one"

# ─────────────────────────────────────────────
# GOOGLE OAUTH (optional)
# ─────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# MICROSOFT OAUTH (optional)
# ─────────────────────────────────────────────
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""

# ─────────────────────────────────────────────
# AI — GOOGLE GEMINI
# ─────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Set to "mock" to use rule-based summaries without an API key
AI_MODE="mock"

# ─────────────────────────────────────────────
# EMAIL — RESEND
# ─────────────────────────────────────────────
# Get from: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"
# Set to "mock" to log emails to console instead of sending
EMAIL_MODE="mock"

# ─────────────────────────────────────────────
# APP SETTINGS
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="StudentInsight"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
